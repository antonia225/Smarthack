# Learning Mode reads these only when an external provider is explicitly used.
# Leave them empty to use the local documentation fallback.
# NETCHECK_LLM_API_KEY=
# NETCHECK_LLM_MODEL=
# Optional OpenAI-compatible endpoint for a local or approved provider:
# NETCHECK_LLM_API_URL=https://api.openai.com/v1/chat/completions

# Local application configuration is stored in lab/network.json.

# Laboratory-only variables (lab/services; never commit real values):
# LAB_BIND_IP=192.0.2.10
# LAB_DB_PASSWORD=generate-a-local-random-password

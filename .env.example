# Export these in the server process environment; .env is NOT loaded automatically.
# Both API_KEY and MODEL enable external requests for Learning Mode questions.
# Leave either unset/empty to use the local documentation fallback.
# Never commit real keys; free-text questions and pseudonymized scan data are sent.
# NETCHECK_LLM_API_KEY=
# NETCHECK_LLM_MODEL=your-approved-model
# Optional OpenAI-compatible endpoint for a local or approved provider:
# NETCHECK_LLM_API_URL=https://api.openai.com/v1/chat/completions

# Local application configuration is stored in lab/network.json.

# Laboratory-only variables (lab/services; never commit real values):
# LAB_BIND_IP=192.0.2.10
# LAB_DB_PASSWORD=generate-a-local-random-password

# Optional remediation agent. POST receives scan_id, device_ip, finding_code, port, lang.
# The agent must return {"status":"ok"} after completion or {"status":"accepted"} if queued.
NETCHECK_REMEDIATION_URL=
NETCHECK_REMEDIATION_API_KEY=
